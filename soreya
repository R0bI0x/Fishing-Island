        for _, v in ipairs(lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") then
                v.Enabled = true
            end
        end
        
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = 0
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Beam") then
                v.Enabled = true
            end
        end
    end)
end)

local function executeCast()
    pcall(function()
        local currentRod = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("Starter Rod") or LocalPlayer.Character:FindFirstChildOfClass("Tool"))
        if currentRod and currentRod:FindFirstChild("Mechanics") then
            local castEvent = currentRod.Mechanics.Remotes:FindFirstChild("CastEvent")
            if castEvent then 
                castEvent:FireServer(false, 100, nil) 
            end
            
            local tandaSeru = ReplicatedStorage:FindFirstChild("TandaSeruBersama")
            if tandaSeru then
                tandaSeru:FireServer(
                    Color3.new(0.33333334326744, 0.63529413938522, 1),
                    Color3.new(0.078431375324726, 0.078431375324726, 0.078431375324726),
                    ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.new(0.33333334326744, 0.63529413938522, 1)),
                        ColorSequenceKeypoint.new(1, Color3.new(0.33333334326744, 0.63529413938522, 1))
                    }),
                    1.5
                )
            end
        end
    end)
end

local isAutoFishing = false

ToggleButton.MouseButton1Click:Connect(function()
    isAutoFishing = not isAutoFishing
    
    if isAutoFishing then
        ToggleButton.Text = "AUTO FISH : ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(39, 201, 63)
        
        task.spawn(function()
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local rod = char:FindFirstChild("Starter Rod") or char:FindFirstChildOfClass("Tool")
            if rod and rod:FindFirstChild("Mechanics") then
                local miniGame = rod.Mechanics.Remotes:FindFirstChild("MiniGame")
                if miniGame then
                    miniGame.OnClientEvent:Connect(function()
                        if isAutoFishing then
                            task.wait(0.6)
                            miniGame:FireServer(true)
                        end
                    end)
                end
            end
        end)
        
        task.spawn(function()
            while isAutoFishing do
                executeCast()
                task.wait(0.8)
            end
        end)
        
    else
        ToggleButton.Text = "AUTO FISH : OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)

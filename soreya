DelCutsceneBtn.MouseButton1Click:Connect(function()
    pcall(function()
        local fishingModules = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Fishing")
        if fishingModules then
            local cutscenes = {"CutsceneForgotten", "CutsceneKitsune", "CutsceneSecret", "CutsceneTangkapan"}
            for _, name in ipairs(cutscenes) do
                local target = fishingModules:FindFirstChild(name)
                if target then
                    target:Destroy()
                end
            end
        end
        
        local efekLempar = ReplicatedStorage:FindFirstChild("EfekLemparKenyal")
        if efekLempar then
            local vfx = efekLempar:FindFirstChild("VFX")
            if vfx then
                vfx:Destroy()
            end
        end
        
        DelCutsceneBtn.Text = "DELETED !"
        DelCutsceneBtn.BackgroundColor3 = Color3.fromRGB(39, 201, 63)
        task.wait(1.5)
        DelCutsceneBtn.Text = "DELETE CUTSCENE"
        DelCutsceneBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end)
end)

-- Perbaikan Total: FPS Booster yang Menggunakan Metode Aman & Efektif Tanpa Error
local isFpsBoostActive = false

FpsBtn.MouseButton1Click:Connect(function()
    isFpsBoostActive = not isFpsBoostActive
    if isFpsBoostActive then
        FpsBtn.Text = "FPS BOOSTER : ON"
        FpsBtn.BackgroundColor3 = Color3.fromRGB(39, 201, 63)
        
        pcall(function()
            local lighting = Lighting
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            
            -- Nonaktifkan efek air yang berat
            if terrain then
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 0
            end
            
            -- Optimasi Lighting
            lighting.GlobalShadows = false
            lighting.FogEnd = 9e9
            lighting.Brightness = 2
            
            for _, v in ipairs(lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") then
                    v.Enabled = false
                end
            end
            
            -- Sembunyikan atau optimalkan semua objek di dunia game
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                    v.CastShadow = false
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v.Transparency = 1
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Beam") then
                    v.Enabled = false
                end
            end
            
            -- Pembersihan memori paksa
            collectgarbage("collect")
        end)
    else
        FpsBtn.Text = "FPS BOOSTER : OFF"
        FpsBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)

ResetGfxBtn.MouseButton1Click:Connect(function()
    isFpsBoostActive = false
    FpsBtn.Text = "FPS BOOSTER : OFF"
    FpsBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    
    pcall(function()
        local lighting = Lighting

function FishBot:ShowMsg(msg, col) 
    self.Notif.Text=msg; 
    self.Notif.TextColor3=col or C3(52,199,89); 
    TS:Create(self.Notif,TweenInfo.new(0.2),{TextTransparency=0}):Play();
    task.delay(0.7, function() TS:Create(self.Notif,TweenInfo.new(0.5),{TextTransparency=1}):Play() end) 
end

function FishBot:Start()
    if not self.Rod then return end;
    self.Active = not self.Active
    self.Btn.Text = self.Active and "Stop Fishing" or "Start Fishing"
    self.Btn.BackgroundColor3 = self.Active and C3(255,59,48) or C3(0,122,255)
    if self.Active then task.spawn(function() while self.Active and self.Rod do self:Loop(); task.wait(1) end end) end
end

function FishBot:Loop()
    local c = P.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    
    if not h or not self.Rod then return end
    
    local tp = h.Position + (h.CFrame.LookVector * self.Dist) - Vector3.new(0, 2, 0)
    local res = "Gagal menangkap ikan"
    local successCatch = false
    
    local s, err = pcall(function()
        local FS = RS:WaitForChild("FishingSystem", 3)
        if not FS then return end

        local equippedRod = c:FindFirstChild(self.Rod)
        if not equippedRod then return end
        
        local castPower = 93.524731248617
        local castPowerFloat = castPower / 100

        local CastEvent = FS:FindFirstChild("CastReplication") or FS:FindFirstChild("RE/CastReplication")
        if CastEvent then
            CastEvent:FireServer(
                tp,
                h.Position,
                self.Rod,
                castPower
            )
            task.wait(1.5) 
        end
        
        if not c:FindFirstChild(self.Rod) then return end

        local sessionResponse = nil
        local RequestSession = FS:FindFirstChild("RequestFishingSession")
        if RequestSession then
            sessionResponse = RequestSession:InvokeServer(
                self.Rod,
                castPowerFloat,
                tp
            )
        end
        
        local sessionToken = sessionResponse
        if type(sessionToken) == "table" then
            sessionToken = sessionToken[1] or sessionToken.sessionToken
        end

        task.wait(FishBot.SessionDelay)

        pcall(function()
            local AbilityEvent = FS:FindFirstChild("AbilityRemotes") and FS.AbilityRemotes:FindFirstChild("NotifyAbilityCast")
            if AbilityEvent then 
                AbilityEvent:FireServer() 
                task.wait(0.2)
            end
        end)
        
        if type(sessionToken) == "string" then
            _G.CapturedSessionToken = sessionToken
            res = "Caught! [Token Acquired]"
            successCatch = true
        end
        
        local CleanupEvent = FS:FindFirstChild("CleanupCast") or FS:FindFirstChild("RE/CleanupCast")
        if CleanupEvent then 
            CleanupEvent:FireServer() 
            task.wait(0.2)
        end
        
        local FishGiver = FS:FindFirstChild("FishGiver") or FS:FindFirstChild("RE/FishGiver")
        if FishGiver and sessionToken then
            FishGiver:FireServer({
                hookPosition = tp,
                sessionToken = sessionToken
            })
            task.wait(0.2)
        end
        
        local SuccessEvent = RS:FindFirstChild("FishingCatchSuccess")
        if SuccessEvent then 
            SuccessEvent:FireServer() 
            task.wait(0.2)
        end
    end)
    
    if s and successCatch and self.Active then 
        self.Caught = self.Caught + 1
        self:ShowMsg(res) 
    end
end


-- AUTO FARM TP LANGSUNG AKTIF (DEFAULT ON)
local isAutoTpActive = true

task.spawn(function()
    local missingCount = 0
    while true do
        if isAutoTpActive then
            pcall(function()
                local found = TeleportToPumpkin()
                if found then
                    missingCount = 0
                else
                    missingCount = missingCount + 1
                    StatusLabel.Text = "Status: Labu tidak ada (" .. missingCount .. "/5)"
                    if missingCount >= 5 then
                        StatusLabel.Text = "Status: Labu habis, melakukan Server Hop..."
                        task.wait(1)
                        ServerHop()
                    end
                end
            end)
        end
        task.wait(2)
    end
end)


-- Fungsi Deteksi Objek `._LabuAktif`
local function FindPumpkinObject()
    local targetCFrame = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "._LabuAktif" or obj.Name:lower():find("labuaktif") then
            if obj:IsA("BasePart") then
                targetCFrame = obj.CFrame
                break
            elseif obj:IsA("Model") then
                targetCFrame = obj:GetPivot()
                break
            elseif obj:IsA("Folder") then
                for _, child in ipairs(obj:GetDescendants()) do
                    if child:IsA("BasePart") then
                        targetCFrame = child.CFrame
                        break
                    elseif child:IsA("Model") then
                        targetCFrame = child:GetPivot()
                        break
                    end
                end
                if targetCFrame then break end
            end
        end
    end
    return targetCFrame
end

-- Fungsi Teleport
local function TeleportToPumpkin()
    local character = LocalPlayer.Character
    if not character then return false end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    
    if not hrp or not humanoid or humanoid.Health <= 0 then return false end

    local pumpkinCFrame = FindPumpkinObject()
    if pumpkinCFrame then
        hrp.CFrame = pumpkinCFrame + Vector3.new(0, 3, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        StatusLabel.Text = "Status: Sukses TP ke ._LabuAktif"
        return true
    end
    return false
end

